@model Pagina
@{ ViewData["Title"] = Model.Titulo; }
<div class="titulo">
<div>
<p class="ceja">CENTRO DE GESTIÓN</p>
<h1>@Model.Titulo</h1>
<p>@Model.Descripcion</p>
</div>
<span class="insignia">@User.Identity?.Name</span>
</div>
<div class="acciones">@foreach (var enlace in Model.Enlaces) { <a class="boton secundario" href="@enlace.Url">@enlace.Texto</a> }</div>
<div class="filtros">@foreach (var filtro in Model.Formularios.Where(f => f.Metodo == "get")) { <partial name="_Formulario" model="filtro"/> }</div>
@if (Model.GeoJson is not null) { <div class="mapa" data-geojson="@Model.GeoJson" aria-label="Mapa de la zona">
</div> }
@if (Model.Columnas.Count > 0) {
<div class="tabla">
<table>
<thead>
<tr>@foreach (var col in Model.Columnas) { <th scope="col">@col</th> }<th>Acciones</th>
</tr>
</thead>
<tbody>
@foreach (var fila in Model.Filas) { <tr>@foreach (var celda in fila.Celdas) { <td>@celda</td> }<td>
<div class="acciones">@foreach (var enlace in fila.Enlaces) { <a href="@enlace.Url">@enlace.Texto</a> }</div>
</td>
</tr> }
</tbody>
</table>@if (Model.Filas.Count == 0) { <p class="vacio">No hay registros para mostrar.</p> }</div>
}
@foreach (var texto in Model.Textos) { <section class="tarjeta">
<h2>@texto.Titulo</h2>
<pre>@texto.Texto</pre>
</section> }
<div class="formularios">@foreach (var formulario in Model.Formularios.Where(f => f.Metodo == "post")) { <partial name="_Formulario" model="formulario"/> }</div>
