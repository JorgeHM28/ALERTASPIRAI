# Copia este archivo como .env (misma carpeta) para que la API de Docker envíe SMS con un celular Android.
# Los datos salen de la app SMS Gateway for Android, sección "Local Server". Ver docs/sms-gateway.md.
# El archivo .env no se sube al repositorio.
SMS_MODO=SmsGateway
SMS_GATEWAY_URL=http://192.168.1.50:8080
SMS_GATEWAY_USUARIO=sms
SMS_GATEWAY_CONTRASENA=cambia-esto
