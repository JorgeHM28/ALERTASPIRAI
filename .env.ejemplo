# Copia este archivo como .env (misma carpeta) para que la API de Docker use canales reales.
# Cada canal queda apagado mientras falten sus datos. El archivo .env no se sube al repositorio.

# --- SMS con un celular Android (docs/sms-gateway.md) ---
SMS_MODO=SmsGateway
SMS_GATEWAY_URL=http://192.168.1.50:8080
SMS_GATEWAY_USUARIO=sms
SMS_GATEWAY_CONTRASENA=cambia-esto

# --- WhatsApp a un grupo con WAHA (docs/whatsapp-email.md) ---
# Arranca WAHA con: docker compose --profile whatsapp up -d
WAHA_API_KEY=una-clave-larga-inventada-por-ustedes
WAHA_DASHBOARD_CONTRASENA=otra-clave-para-el-panel
WHATSAPP_URL=http://waha:3000
WHATSAPP_GRUPO_NOMBRE=Alertas río Piraí
WHATSAPP_GRUPO_ID=120363000000000000@g.us
# En una PC con procesador Intel/AMD usa: WAHA_IMAGEN=devlikeapro/waha
# WAHA_IMAGEN=devlikeapro/waha:arm

# --- Email por SMTP (Gmail con contraseña de aplicación) ---
EMAIL_SERVIDOR=smtp.gmail.com
EMAIL_PUERTO=587
EMAIL_USUARIO=cuenta.del.equipo@gmail.com
EMAIL_CONTRASENA=contraseña-de-aplicacion-de-16-letras
EMAIL_REMITENTE=cuenta.del.equipo@gmail.com
